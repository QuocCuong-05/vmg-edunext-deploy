// ============================================================
// VMG EduNext — Database ERD Diagram
// Dùng cho dbdiagram.io — paste toàn bộ vào đó
// ============================================================

// ------------------------------------------------------------
// ENUMS
// ------------------------------------------------------------
Enum course_level {
  A1
  A2
  B1
  "B1+"
  B2
  C1
}

Enum enrollment_status {
  active
  completed
  dropped
}

Enum lesson_content_type {
  video
  article
  quiz
  assignment
}

Enum user_role {
  learner
  teacher
  admin
  super_admin
}

Enum quest_type {
  daily
  weekly
}

Enum reward_content_type {
  lessons
  vocabulary
  prompts
  webinar
}

// ------------------------------------------------------------
// TABLES
// ------------------------------------------------------------

// Placeholder: auth.users là built-in của Supabase
Table auth.users {
  id uuid [pk]
}

Table profiles {
  id          uuid          [pk]
  full_name   text
  avatar_url  text
  role        user_role     [not null, default: 'learner']
  xp          integer       [not null, default: 0]
  streak_days integer       [not null, default: 0]
  bio         text
  created_at  timestamptz   [not null, default: `now()`]
  updated_at  timestamptz   [not null, default: `now()`]
}

// Ghi chú: Mở rộng auth.users. Tự động tạo khi user signup.

Table courses {
  id             uuid          [pk]
  title          text          [not null]
  slug           text          [not null, unique]
  description    text          [not null, default: '']
  thumbnail      text
  level          course_level  [not null, default: 'B1']
  category       text          [not null, default: 'general']
  duration_hours numeric
  lesson_count   integer       [default: 0]
  instructor     text          [default: 'VMG EduNext']
  is_published   boolean       [not null, default: false]
  created_at     timestamptz   [not null, default: `now()`]
  updated_at     timestamptz   [not null, default: `now()`]
}

// Ghi chú: Khóa học. 1 course có nhiều lessons và enrollments.

Table lessons {
  id                     uuid                [pk]
  course_id              uuid                [not null, ref: > courses.id]
  title                  text                [not null]
  slug                   text                [not null]
  description            text
  sort_order             integer             [not null, default: 0]
  content_type           lesson_content_type [not null, default: 'video']
  video_url              text
  video_duration_seconds integer
  article_body           text
  is_free                boolean             [not null, default: false]
  created_at             timestamptz         [not null, default: `now()`]
  updated_at             timestamptz         [not null, default: `now()`]
  indexes {
    (course_id)
    (course_id, sort_order)
    (course_id, slug) [unique]
  }
}

// Ghi chú: Bài học trong khóa học. FK → courses.

Table enrollments {
  id            uuid              [pk]
  user_id       uuid              [not null, ref: > auth.users.id]
  course_id     uuid              [not null, ref: > courses.id]
  status        enrollment_status [not null, default: 'active']
  progress_pct  numeric           [not null, default: 0]
  enrolled_at   timestamptz       [not null, default: `now()`]
  completed_at  timestamptz
  indexes {
    (user_id)
    (course_id)
    (user_id, course_id) [unique]
  }
}

// Ghi chú: User tham gia khóa học. FK → auth.users + courses.

Table lesson_progress {
  id              uuid      [pk]
  user_id         uuid      [not null, ref: > auth.users.id]
  lesson_id       uuid      [not null, ref: > lessons.id]
  completed       boolean   [not null, default: false]
  watched_seconds integer
  score           integer
  completed_at    timestamptz
  indexes {
    (user_id)
    (lesson_id)
    (user_id, lesson_id) [unique]
  }
}

// Ghi chú: Tiến độ từng bài của user. FK → auth.users + lessons.

Table achievements {
  id          uuid        [pk]
  user_id     uuid        [not null, ref: > auth.users.id]
  title       text        [not null]
  description text
  icon        text
  earned_at   timestamptz [not null, default: `now()`]
  indexes {
    (user_id)
  }
}

// Ghi chú: Thành tích đạt được. FK → auth.users.

Table vocabulary_entries {
  id             uuid          [pk]
  word           text          [not null]
  part_of_speech text          [not null]
  level          course_level  [not null, default: 'B1']
  meaning_vi     text          [not null]
  definition_en  text          [not null]
  example_en     text
  example_vi     text
  collocation    text
  topic          text
  is_published   boolean       [not null, default: false]
  created_at     timestamptz   [not null, default: `now()`]
  updated_at     timestamptz   [not null, default: `now()`]
  indexes {
    (level)
    (topic)
  }
}

// Ghi chú: Từ vựng giáo dục. Route: /api/vocabulary

Table classroom_phrase_categories {
  id         uuid      [pk]
  slug       text      [not null, unique]
  name_vi    text      [not null]
  sort_order integer   [not null, default: 0]
  icon       text
  created_at timestamptz [not null, default: `now()`]
}

// Ghi chú: Danh mục câu lệnh lớp. Route: /api/classroom/categories

Table classroom_phrases {
  id           uuid          [pk]
  category_id  uuid          [ref: > classroom_phrase_categories.id]
  phrase_en    text          [not null]
  phrase_vi    text          [not null]
  purpose      text
  level        course_level
  sort_order   integer       [not null, default: 0]
  is_published boolean       [not null, default: false]
  created_at   timestamptz   [not null, default: `now()`]
  updated_at   timestamptz   [not null, default: `now()`]
  indexes {
    (category_id)
    (level)
  }
}

// Ghi chú: Câu lệnh lớp song ngữ. FK → classroom_phrase_categories. Route: /api/classroom

Table quiz_sets {
  id             uuid          [pk]
  title          text          [not null]
  slug           text          [not null, unique]
  description    text
  passing_score  integer       [not null, default: 70]
  xp_reward      integer       [not null, default: 0]
  level          course_level
  question_count integer       [not null, default: 0]
  is_published   boolean       [not null, default: false]
  created_at     timestamptz   [not null, default: `now()`]
  updated_at     timestamptz   [not null, default: `now()`]
}

// Ghi chú: Bộ câu hỏi. Route: /api/quiz/sets

Table quiz_questions {
  id                 uuid          [pk]
  quiz_set_id        uuid          [not null, ref: > quiz_sets.id]
  prompt             text          [not null]
  prompt_translation text
  correct_answer     text
  explanation        text
  explanation_vi     text
  competency_code    text
  level              course_level
  sort_order         integer       [not null, default: 0]
  created_at         timestamptz   [not null, default: `now()`]
  indexes {
    (quiz_set_id)
  }
}

// Ghi chú: Câu hỏi trong quiz. FK → quiz_sets

Table quiz_options {
  id                 uuid      [pk]
  question_id        uuid      [not null, ref: > quiz_questions.id]
  option_text        text      [not null]
  is_correct         boolean   [not null, default: false]
  feedback_correct   text
  feedback_incorrect text
  sort_order         integer   [not null, default: 0]
  created_at         timestamptz [not null, default: `now()`]
  indexes {
    (question_id)
  }
}

// Ghi chú: Lựa chọn trả lời. FK → quiz_questions. 4 options / câu, 1 đáp án đúng.

Table tips {
  id           uuid        [pk]
  title        text        [not null]
  content      text        [not null]
  category     text
  is_published boolean     [not null, default: false]
  created_at   timestamptz [not null, default: `now()`]
  updated_at   timestamptz [not null, default: `now()`]
  indexes {
    (category)
  }
}

// Ghi chú: Mẹo dạy học (Dashboard).

Table quests {
  id         text        [pk]
  type       quest_type  [not null]
  title      text        [not null]
  desc_text  text
  xp         integer     [not null, default: 0]
  is_active  boolean     [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
}

// Ghi chú: Nhiệm vụ ngày/tuần. Dữ liệu tĩnh.

Table user_quests {
  id           uuid        [pk]
  user_id      uuid        [not null, ref: > auth.users.id]
  quest_id     text        [not null, ref: > quests.id]
  date_key     text        [not null]
  completed    boolean     [not null, default: false]
  completed_at timestamptz
  indexes {
    (user_id)
    (date_key)
    (user_id, quest_id, date_key) [unique]
  }
}

// Ghi chú: Trạng thái quest của user. FK → auth.users + quests

Table rewards {
  id           uuid                [pk]
  name         text                [not null]
  desc_text    text                [not null]
  price        integer             [not null]
  icon_type    text                [not null]
  content_type reward_content_type [not null]
  content_json jsonb               [not null, default: '{}']
  stock        integer
  is_active    boolean             [not null, default: true]
  created_at   timestamptz         [not null, default: `now()`]
  updated_at   timestamptz         [not null, default: `now()`]
}

// Ghi chú: Cửa hàng phần thưởng. content_json chứa items / webinar info.

Table user_purchases {
  id           uuid        [pk]
  user_id      uuid        [not null, ref: > auth.users.id]
  reward_id    uuid        [not null, ref: > rewards.id]
  xp_spent     integer     [not null]
  purchased_at timestamptz [not null, default: `now()`]
  indexes {
    (user_id)
    (reward_id)
  }
}

// Ghi chú: Lịch sử đổi thưởng. FK → auth.users + rewards.

Table word_book_entries {
  id             uuid          [pk]
  user_id        uuid          [not null, ref: > auth.users.id]
  word           text          [not null]
  part_of_speech text
  level          course_level
  meaning_vi     text
  definition_en  text
  example_en     text
  notes          text
  mastered       boolean       [not null, default: false]
  created_at     timestamptz   [not null, default: `now()`]
  updated_at     timestamptz   [not null, default: `now()`]
  indexes {
    (user_id)
    (user_id, word) [unique]
  }
}

// Ghi chú: Từ vựng cá nhân của từng user. FK → auth.users.
